<Window x:Class="AvionPlot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:AvionPlot.Views"
        Title="GraphVisualizer"
        Height="650"
        Width="1000"
        AllowDrop="True"
        Drop="MainWindow_Drop">

    <DockPanel>
        <local:MenuBar x:Name="MenuBarControl" DockPanel.Dock="Top"/>

        <Grid x:Name="MainGrid">

            <oxy:PlotView x:Name="PlotView"/>

            <Border x:Name="SidePanel"
                    Background="#F0F0F0"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Width="320"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed">
                <StackPanel Margin="10">

                    <!-- Математическая модель -->
                    <TextBlock Text="Математическая модель"
                               FontWeight="Bold"
                               FontSize="14"/>
                    <ScrollViewer Height="200">
                        <TextBlock x:Name="platformModelTextBlock"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   FontSize="12"/>
                    </ScrollViewer>

                    <!-- Список файлов -->
                    <TextBlock Text="Файлы в папке"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,10,0,5"/>
                    <ListBox x:Name="FilesListBox"
                             FontFamily="Consolas"
                             FontSize="12"
                             SelectionMode="Single"
                             MouseLeftButtonUp="FilesListBox_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Margin="0,0,5,0"
                                              IsChecked="{Binding IsChecked}"/>
                                    <TextBlock Text="{Binding FileName}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </StackPanel>
            </Border>

            <!-- Кнопка сброса масштаба -->
            <Button Width="40"
                    Height="40"
                    FontSize="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="40,70"
                    Click="ResetZoom_Clicked"
                    ToolTip="Сбросить масштаб"
                    Opacity="0.85"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                ⟳
            </Button>

        </Grid>
    </DockPanel>
</Window>
